[Unit]
Description=Micro devops agent
After=network-online.target
Wants=network-online.target

[Service]
User=micro-agents
Group=micro-agents
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/micro-agents
ExecStart=/opt/micro-agents/devops
Environment=HOME=/var/lib/micro-agents/devops
EnvironmentFile=/etc/micro-agents/common.env
EnvironmentFile=-/etc/micro-agents/devops.env
StateDirectory=micro-agents/devops
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
