[Unit]
Description=Micro monitor agent
After=network-online.target
Wants=network-online.target

[Service]
User=micro-agents
Group=micro-agents
WorkingDirectory=/opt/micro-agents
ExecStart=/opt/micro-agents/monitor
Environment=HOME=/var/lib/micro-agents/monitor
EnvironmentFile=/etc/micro-agents/common.env
EnvironmentFile=-/etc/micro-agents/monitor.env
StateDirectory=micro-agents/monitor
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
